<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="physical_ai_rover">

  <!-- Color Materials -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="blue"><color rgba="0.1 0.4 0.8 1.0"/></material>
  <material name="orange"><color rgba="0.9 0.4 0.1 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="silver"><color rgba="0.75 0.75 0.75 1.0"/></material>

  <!-- Robot Footprint & Base Link -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.18 0.08"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.18 0.08"/>
      </geometry>
    </collision>
  </link>

  <!-- Macro for Wheels (4WD) -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.570796 0 0"/>
        <geometry>
          <cylinder radius="0.045" length="0.035"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.570796 0 0"/>
        <geometry>
          <cylinder radius="0.045" length="0.035"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * 0.09} ${y_reflect * 0.11} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
  <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1"/>

  <!-- IMU Sensor Link -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.005"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.085" rpy="0 0 0"/>
  </joint>

  <!-- USB Webcam Frame -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.08 0.03"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.14 0 0.07" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- ================= 6-DOF ROBOT ARM ================= -->
  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.04 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Joint 1: Base Yaw -->
  <joint name="arm_joint1" type="revolute">
    <parent link="arm_base_link"/>
    <child link="arm_link1"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.5"/>
  </joint>
  <link name="arm_link1">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="silver"/>
    </visual>
  </link>

  <!-- Joint 2: Shoulder Pitch -->
  <joint name="arm_joint2" type="revolute">
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="15" velocity="1.5"/>
  </joint>
  <link name="arm_link2">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.025 0.03 0.14"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <!-- Joint 3: Elbow Pitch -->
  <joint name="arm_joint3" type="revolute">
    <parent link="arm_link2"/>
    <child link="arm_link3"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="1.5"/>
  </joint>
  <link name="arm_link3">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.02 0.025 0.12"/></geometry>
      <material name="silver"/>
    </visual>
  </link>

  <!-- Joint 4: Wrist Pitch -->
  <joint name="arm_joint4" type="revolute">
    <parent link="arm_link3"/>
    <child link="arm_link4"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2.0"/>
  </joint>
  <link name="arm_link4">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.05"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Joint 5: Wrist Roll -->
  <joint name="arm_joint5" type="revolute">
    <parent link="arm_link4"/>
    <child link="arm_link5"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="2.0"/>
  </joint>
  <link name="arm_link5">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><cylinder radius="0.012" length="0.03"/></geometry>
      <material name="silver"/>
    </visual>
  </link>

  <!-- Joint 6: Wrist Yaw / End Effector Flange -->
  <joint name="arm_joint6" type="revolute">
    <parent link="arm_link5"/>
    <child link="arm_link6"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2.0"/>
  </joint>
  <link name="arm_link6">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.04 0.05 0.015"/></geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <!-- Gripper Fingers -->
  <joint name="gripper_joint" type="prismatic">
    <parent link="arm_link6"/>
    <child link="gripper_left_finger"/>
    <origin xyz="0 0.015 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.02" effort="5" velocity="0.5"/>
  </joint>
  <link name="gripper_left_finger">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.01 0.005 0.03"/></geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="arm_link6"/>
    <child link="gripper_right_finger"/>
    <origin xyz="0 -0.015 0.02" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.02" effort="5" velocity="0.5"/>
    <mimic joint="gripper_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="gripper_right_finger">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.01 0.005 0.03"/></geometry>
      <material name="red"/>
    </visual>
  </link>

</robot>
